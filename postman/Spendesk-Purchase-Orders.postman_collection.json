        },
        {
          "name": "GET Analytical fields (save po_analytical_field_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const rows = j.data || [];",
                  "const f = rows.find(r => r && r.isArchived === false) || rows[0];",
                  "if (f?.id) {",
                  "  pm.environment.set('po_analytical_field_id', f.id);",
                  "  console.log('po_analytical_field_id=', f.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{base_url}}/v1/analytical-fields?page=1&pageSize=30"
          },
          "response": []
        },
