          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{base_url}}/v1/analytical-fields/{{po_analytical_field_id}}/values?page=1&pageSize=30"
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 PO — List (GET /v1/purchase-orders)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List 200', function () { pm.expect(pm.response.code).to.eql(200); });",
              "const j = pm.response.json();",
              "const data = j.data || j.purchaseOrders || [];",
              "if (data[0]?.id) {",
              "  pm.environment.set('po_id', data[0].id);",
              "  console.log('po_id (1er de la page)=', data[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "url": "{{base_url}}/v1/purchase-orders?page=1&pageSize=30"
      },
      "response": []
    },
    {
      "name": "04 PO — Get by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get 200', function () { pm.expect(pm.response.code).to.eql(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "url": "{{base_url}}/v1/purchase-orders/{{po_id}}?withItems=false"
      },
      "response": []
    },
    {
      "name": "05 PO — Create (POST /v1/purchase-orders)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const t = Date.now() + '-' + Math.random().toString(36).slice(2, 8);",
              "pm.environment.set('po_run_tag', t);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "const id = j.data?.id || j.id;",
              "if (id) {",
              "  pm.environment.set('po_id_last_created', id);",
              "  console.log('po_id_last_created=', id);",
              "}",
              "if (pm.response.code === 201) {",
              "  pm.test('Created 201', function () { pm.expect(pm.response.code).to.eql(201); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{po_user_id}}\",\n  \"supplierId\": \"{{po_supplier_id}}\",\n  \"amount\": { \"amount\": 50000, \"currency\": \"EUR\", \"precision\": 2 },\n  \"netAmount\": { \"amount\": 50000, \"currency\": \"EUR\", \"precision\": 2 },\n  \"costCenterId\": \"{{po_cost_center_id}}\",\n  \"startDate\": \"2026-04-01T10:00:00.000Z\",\n  \"endDate\": \"2026-12-31T18:00:00.000Z\",\n  \"customFieldAssociations\": [\n    {\n      \"customFieldId\": \"{{po_analytical_field_id}}\",\n      \"customFieldValueId\": \"{{po_analytical_value_id}}\"\n    }\n  ],\n  \"description\": \"Postman PO {{po_run_tag}}\",\n  \"items\": [\n    {\n      \"name\": \"Ligne test {{po_run_tag}}\",\n      \"quantity\": 1,\n      \"unitPrice\": { \"amount\": 50000, \"currency\": \"EUR\", \"precision\": 2 },\n      \"vatRate\": 0\n    }\n  ],\n  \"deliveryNotesExpected\": false\n}"
        },
        "url": "{{base_url}}/v1/purchase-orders"
      },
      "response": []
    },
    {
      "name": "05b PO — Create (minimal, customFieldAssociations [])",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const t = Date.now() + '-m-' + Math.random().toString(36).slice(2, 8);",
              "pm.environment.set('po_run_tag', t);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "const id = j.data?.id || j.id;",
              "if (id) pm.environment.set('po_id_last_created', id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{po_user_id}}\",\n  \"supplierId\": \"{{po_supplier_id}}\",\n  \"amount\": { \"amount\": 50000, \"currency\": \"EUR\", \"precision\": 2 },\n  \"netAmount\": { \"amount\": 50000, \"currency\": \"EUR\", \"precision\": 2 },\n  \"costCenterId\": \"{{po_cost_center_id}}\",\n  \"startDate\": \"2026-04-01T10:00:00.000Z\",\n  \"endDate\": \"2026-12-31T18:00:00.000Z\",\n  \"customFieldAssociations\": [],\n  \"description\": \"Postman PO minimal {{po_run_tag}}\",\n  \"items\": [],\n  \"deliveryNotesExpected\": false\n}"
        },
        "url": "{{base_url}}/v1/purchase-orders"
      },
      "response": []
    },
    {
