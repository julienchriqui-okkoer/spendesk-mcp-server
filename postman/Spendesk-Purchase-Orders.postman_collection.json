        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "url": "{{base_url}}/v1/purchase-orders/{{po_id_cancel}}/cancel"
      },
      "response": []
    },
    {
      "name": "07 PO — Close (POST .../close)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "url": "{{base_url}}/v1/purchase-orders/{{po_id_close}}/close"
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://beta-sandbox.api.trunk.spendesk.services" },
    { "key": "access_token", "value": "" },
