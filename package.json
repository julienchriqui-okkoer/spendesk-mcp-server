{
  "name": "spendesk-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Spendesk Public API - ERP integrations and dashboards",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "spendesk-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "prepare": "pre-commit install || true",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "start:http": "node dist/server-http.js",
    "test": "npm run build && node --test tests/fetch-all-payables.test.mjs tests/ephemeral-sqlite.test.mjs",
    "test:load-query-po": "node scripts/test-load-query-purchase-orders.mjs",
    "test:sandbox-api": "SPENDESK_API_TOKEN= node scripts/test-sandbox-direct-api.mjs",
    "test:mcp": "SPENDESK_API_TOKEN= SPENDESK_REFRESH_TOKEN= node scripts/test-mcp.mjs",
    "test:mcp-po": "SPENDESK_API_TOKEN= SPENDESK_REFRESH_TOKEN= node -r dotenv/config scripts/test-mcp-purchase-orders-tools.mjs",
    "test:po-api": "node -r dotenv/config scripts/test-purchase-orders-api.mjs",
    "test:suppliers-archive-cycle": "node -r dotenv/config scripts/test-suppliers-archive-cycle.mjs",
    "test:mcp-suppliers-archive-cycle": "SPENDESK_API_TOKEN= SPENDESK_REFRESH_TOKEN= node -r dotenv/config scripts/test-mcp-suppliers-archive-cycle.mjs",
    "unarchive:suppliers": "node -r dotenv/config scripts/unarchive-suppliers-by-ids.mjs",
    "docs:sync-tools": "node scripts/sync-docs-enabled-tools.mjs",
    "docs:dev": "npm run docs:sync-tools && cd spendesk-mcp-docs && npm run dev",
    "slides:dev": "vite --config slides/vite.config.ts",
    "slides:build": "vite build --config slides/vite.config.ts",
    "slides:preview": "vite preview --config slides/vite.config.ts"
  },
  "keywords": [
    "mcp",
    "spendesk",
    "api",
    "erp",
    "integration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "alasql": "^4.17.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.3.1",
    "express-rate-limit": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  }
}
