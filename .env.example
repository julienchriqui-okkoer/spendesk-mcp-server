# Encryption key for client tokens (32 bytes hex, 64 characters).
# Generate one with: node scripts/generate-encryption-key.mjs
# REQUIRED for multi-tenant mode.
ENCRYPTION_KEY=your_64_character_hex_key_here

# Spendesk API token (Bearer). Get it from Spendesk: Settings > Integrations > API access management.
# OPTIONAL: Only needed if clients don't register via /ui portal (fallback mode).
# Do not commit real tokens.
SPENDESK_API_TOKEN=your_token_here

# Set to true to use the demo API
SPENDESK_USE_DEMO=false

# Database path (default: ./data/clients.db)
# DB_PATH=./data/clients.db
