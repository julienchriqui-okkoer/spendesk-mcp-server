# Spendesk API token (Bearer). Get it from Spendesk: Settings > Integrations > API access management.
# Used by default when the client does not send explicit credentials.
# Do not commit real tokens.
SPENDESK_API_TOKEN=your_token_here

# OAuth2 refresh token. When set with SPENDESK_API_TOKEN, the server will auto-refresh on 401 so long workflows don't fail.
# OPTIONAL. Leave unset if using a long-lived API token.
# SPENDESK_REFRESH_TOKEN=your_refresh_token_here

# Client credentials (dashboard Spendesk). Alternative to SPENDESK_API_TOKEN.
# POST /v1/auth/token with Basic(client_id:client_secret) and grant_type: client_credentials.
# SPENDESK_CLIENT_ID=your_client_id
# SPENDESK_CLIENT_SECRET=your_client_secret

# Demo environment: when SPENDESK_USE_DEMO=true, URL and fallback credentials switch to demo.
# SPENDESK_CLIENT_ID_DEMO=your_demo_client_id
# SPENDESK_CLIENT_SECRET_DEMO=your_demo_client_secret

# Set to true to use the demo API (beta-sandbox) and SPENDESK_CLIENT_ID_DEMO / SPENDESK_CLIENT_SECRET_DEMO.
# Set to false or unset for production (public-api.spendesk.com) and SPENDESK_CLIENT_ID / SPENDESK_CLIENT_SECRET.
SPENDESK_USE_DEMO=false

# Database path for MCP usage monitoring (default: ./data/clients.db)
# DB_PATH=./data/clients.db
