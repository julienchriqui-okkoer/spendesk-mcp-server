# Spendesk OAuth2 client credentials (required for MCP stdio and recommended for HTTP server fallback).
# Create in Spendesk: Settings > Integrations > API access management.
# Do not commit real secrets.
# SPENDESK_CLIENT_ID=your_client_id
# SPENDESK_CLIENT_SECRET=your_client_secret

# Demo environment: when SPENDESK_USE_DEMO=true, URL and credentials switch to demo / sandbox.
# SPENDESK_CLIENT_ID_DEMO=your_demo_client_id
# SPENDESK_CLIENT_SECRET_DEMO=your_demo_client_secret

# Set to true to use the demo API (beta-sandbox) and demo client id/secret vars.
# Set to false or unset for production (public-api.spendesk.com).
SPENDESK_USE_DEMO=false

# Optional: override API base URL (no trailing slash).
# SPENDESK_BASE_URL=https://public-api.spendesk.com

# Database path for MCP usage monitoring (default: ./data/clients.db)
# DB_PATH=./data/clients.db
